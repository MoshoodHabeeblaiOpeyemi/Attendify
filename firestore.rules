rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userExists() {
      return signedIn() && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function hasUserProfile() {
      return userExists()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.uid == request.auth.uid;
    }

    function isCourseRep(courseId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/courses/$(courseId)
        )
        && get(
          /databases/$(database)/documents/courses/$(courseId)
        ).data.repUid == request.auth.uid;
    }

    function isCourseMember(courseId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/courses/$(courseId)/members/$(request.auth.uid)
        );
    }

    function isCourseStaff(courseId) {
      return isCourseRep(courseId) || (
        isCourseMember(courseId)
        && get(
          /databases/$(database)/documents/courses/$(courseId)/members/$(request.auth.uid)
        ).data.role == 'assistant'
      );
    }

    function validCourseFields() {
      return request.resource.data.repUid is string
        && request.resource.data.repUid == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.institution is string
        && request.resource.data.institution.size() > 0
        && request.resource.data.department is string
        && request.resource.data.department.size() > 0
        && request.resource.data.level is string
        && request.resource.data.level.size() > 0;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.matric is string
        && request.resource.data.matric.size() > 0
        && request.resource.data.isRep is bool;

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.matric == resource.data.matric
        && request.resource.data.isRep == resource.data.isRep
        && request.resource.data.institution == resource.data.institution
        && request.resource.data.department == resource.data.department;

      allow delete: if false;
    }

    match /departmentReps/{repId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.repUid == request.auth.uid;
      allow update, delete: if isOwner(repId);
    }

    match /courses/{courseId} {
      allow read: if signedIn();

      allow create: if hasUserProfile() && validCourseFields();

      allow update: if isCourseStaff(courseId)
        && request.resource.data.repUid == resource.data.repUid
        && request.resource.data.code == resource.data.code
        && request.resource.data.institution == resource.data.institution
        && request.resource.data.department == resource.data.department
        && request.resource.data.level == resource.data.level;

      allow delete: if isCourseRep(courseId);

      match /members/{memberUid} {
        allow read: if signedIn() && (
          request.auth.uid == memberUid || isCourseStaff(courseId)
        );

        // Normal student enrollment must be performed by the trusted backend.
        // The backend uses Firebase Admin credentials and bypasses client rules.
       allow create: if isCourseRep(courseId)
          && request.resource.data.uid == memberUid
          && request.resource.data.role in ['student', 'assistant', 'rep']; 

        allow update: if isCourseRep(courseId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role in ['student', 'assistant', 'rep'];

        allow delete: if isCourseRep(courseId)
          || (signedIn() && request.auth.uid == memberUid);
      }

      match /session/live {
        allow read: if signedIn() && (
          isCourseStaff(courseId) || isCourseMember(courseId)
        );
        allow create, update, delete: if isCourseStaff(courseId);
      }

      match /session/secret {
        // Assistants need to read the PIN during a live session.
        // Write is rep-only (they generate the session).
        allow read: if isCourseStaff(courseId);
        allow write: if isCourseRep(courseId);
      }

      match /attendance/{attendanceId} {
        // Rep and assistants can read all records (archive view).
        // Enrolled students can read to power their personal analytics.
        allow read: if isCourseStaff(courseId) || isCourseMember(courseId);
        // All writes go through the trusted backend (Admin SDK), never the client.
        allow write: if false;
      }
    }
  }
}
