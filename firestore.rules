rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    
    function getUserMatric() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.matric;
    }

    function isCourseStaff(courseId) {
      let course = get(/databases/$(database)/documents/courses/$(courseId)).data;
      let userMatric = getUserMatric();
      return isSignedIn() && (
        course.repUid == request.auth.uid ||
        (course.assistants != null && userMatric in course.assistants)
      );
    }
    
    // Students can ONLY add/remove themselves from enrolled[],
    // or remove themselves from assistants[].
    // No if-statements allowed — pure boolean logic only.
    function isSelfManagingEnrollment() {
      let userMatric = getUserMatric();
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      
      return affected.hasOnly(['enrolled', 'assistants'])
        && (
          resource.data.enrolled == request.resource.data.enrolled
          || (
            resource.data.enrolled != null
            && request.resource.data.enrolled != null
            && (
              (request.resource.data.enrolled.size() == resource.data.enrolled.size() + 1
               && !(userMatric in resource.data.enrolled)
               && userMatric in request.resource.data.enrolled)
              ||
              (request.resource.data.enrolled.size() == resource.data.enrolled.size() - 1
               && userMatric in resource.data.enrolled
               && !(userMatric in request.resource.data.enrolled))
            )
          )
        )
        && (
          resource.data.assistants == request.resource.data.assistants
          || (
            resource.data.assistants != null
            && request.resource.data.assistants != null
            && request.resource.data.assistants.size() == resource.data.assistants.size() - 1
            && userMatric in resource.data.assistants
            && !(userMatric in request.resource.data.assistants)
          )
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isRep', 'institution', 'department']);
      allow delete: if isOwner(userId);
    }

    match /departmentReps/{slotId} {
      allow read: if true; 
      allow create: if isSignedIn() && request.resource.data.repUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isCourseStaff(courseId) || isSelfManagingEnrollment();
      allow delete: if isCourseStaff(courseId);

      match /session/live {
        allow read: if isSignedIn();
        allow write: if isCourseStaff(courseId);
      }

      match /session/secret {
        allow read, write: if isCourseStaff(courseId);
      }

      match /attendance/{document=**} {
        allow read: if isCourseStaff(courseId);
        allow write: if false; 
      }
    }
  }
}